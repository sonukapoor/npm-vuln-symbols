{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sonukapoor/npm-vuln-symbols/schema/advisory.schema.json",
  "title": "npm vulnerable symbol record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "aliases",
    "affected",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(GHSA-[23456789cfghjmpqrvwx]{4}-[23456789cfghjmpqrvwx]{4}-[23456789cfghjmpqrvwx]{4}|CVE-[0-9]{4}-[0-9]{4,})$",
      "description": "OSV identifier, normally a GHSA id."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per affected npm package, mirroring OSV's affected[].",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "symbols"
        ],
        "properties": {
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ecosystem",
              "name"
            ],
            "properties": {
              "ecosystem": {
                "const": "npm"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "symbols": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Vulnerable exports. An empty array reads downstream as 'nothing is reachable', which is the unsafe answer, so it is invalid."
          },
          "modulePath": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "confidence"
      ],
      "properties": {
        "source": {
          "enum": [
            "advisory_text",
            "fix_commit",
            "advisory_text+fix_commit",
            "manual"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "fixCommit": {
          "type": "string",
          "format": "uri"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "reviewedBy": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "trigger": {
      "enum": [
        "call",
        "data_value"
      ],
      "description": "How the vulnerability is triggered. Defaults to 'call'. A 'data_value' record is triggered by passing a value or option key and cannot be resolved by call-pattern reachability, so it must never be used to eliminate a finding."
    }
  }
}
